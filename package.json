{
  "name": "tharior-remedai-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Enterprise Agentic Autonomous Coding & Remediation Monorepo backed by Anvesh",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=apps/web-desk",
    "dev:web": "npm run dev --workspace=apps/web-desk",
    "dev:api": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8000 --app-dir apps/api-gateway",
    "dev:docs": "python3 -m http.server 8080 --directory apps/docs-site",
    "test:python": "pytest -v",
    "test": "npm run test:python && npm run build --workspace=apps/web-desk",
    "lint": "npm run lint --workspace=apps/web-desk"
  },
  "keywords": [
    "autonomous-coding-agent",
    "agentic-ai",
    "remediation",
    "10-tier-llm",
    "anvesh",
    "mcp",
    "monorepo"
  ],
  "author": "Vaaga Tech",
  "license": "Apache-2.0"
}
